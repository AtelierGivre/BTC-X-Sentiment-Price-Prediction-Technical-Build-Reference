# Separate secrets file. Copy to .env, fill in the values, and keep the filled
# copy out of git (it is already in .gitignore). This example is safe to commit.
# APIFY_TOKEN and APIFY_ACTOR_ID are required for the real tweet scrape.

APIFY_TOKEN=
# xquik~x-tweet-scraper: cheapest tested actor that honours ISO time windows.
APIFY_ACTOR_ID=wAusCMrm284Voaw86

TAVILY_API_KEY=
TRANSFORMER_MODEL=

SYMBOL=BTCUSDT

# Price history (free, no key). 180 days gives the models enough warm-up.
DAYS=180

# Tweet coverage. The FREE Apify plan has a $5 monthly credit, so 180 days is
# not affordable at ~$0.15/1K tweets. One "Top" query per day x 480 items covers
# 23/24 hours; 60 days = 28.8K tweets ~= $4.32. The live credit check stops safely.
TWEET_DAYS=60
WINDOWS_PER_DAY=1
MAX_ITEMS_PER_WINDOW=480
APIFY_BUDGET_USD=4.60

SEARCH_QUERY="($BTC OR #Bitcoin OR bitcoin) lang:en -filter:replies -filter:retweets"
